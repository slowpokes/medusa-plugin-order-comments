{
  "name": "medusa-plugin-order-comments",
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.1",
  "description": "Internal order comments with author attribution and history for the Medusa Admin.",
  "author": "Vadim <vadim.beglov@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slowpokes/medusa-plugin-order-comments.git"
  },
  "homepage": "https://github.com/slowpokes/medusa-plugin-order-comments#readme",
  "bugs": {
    "url": "https://github.com/slowpokes/medusa-plugin-order-comments/issues"
  },
  "files": [
    ".medusa/server",
    "assets",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusajs",
    "order-comments",
    "order-notes",
    "ecommerce"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "pnpm test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "release:check": "node scripts/validate-package.mjs && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && npm pack --dry-run",
    "prepublishOnly": "node scripts/validate-package.mjs && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.17.2 <3",
    "@medusajs/admin-shared": ">=2.17.2 <3",
    "@medusajs/cli": ">=2.17.2 <3",
    "@medusajs/framework": ">=2.17.2 <3",
    "@medusajs/icons": ">=2.17.2 <3",
    "@medusajs/js-sdk": ">=2.17.2 <3",
    "@medusajs/medusa": ">=2.17.2 <3",
    "@medusajs/test-utils": ">=2.17.2 <3",
    "@medusajs/ui": ">=4.2.0 <5",
    "@tanstack/react-query": ">=5 <6",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/eslint-plugin": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/test-utils": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  }
}
